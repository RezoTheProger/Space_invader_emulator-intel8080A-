                    1 => {
                        //LDAX B

                        let byte: u16 =
                            ((self.registers[0] as u16) << 8) | self.registers[1] as u16;
                        self.registers[7] = self.memory[byte as usize];
                    }
                    2 => {
                        //STAX D
