                    self.flag |= if carry == true { 1 } else { 0 };
                    self.registers[4] = (sum >> 8) as u8;
                    self.registers[5] = sum as u8;
                }
                4 => {
                    let a: u8 = self.fetch();
                    let b: u8 = self.fetch();

                    self.registers[5] = a;
                    self.registers[4] = b;
                }
                5 => {
                    self.flag &= 0xFE;
                    let hl_byte: u16 = concatenate(self.registers[4], self.registers[5]);
                    let (sum, carry): (u16, bool) = hl_byte.overflowing_add(hl_byte);
                    self.flag |= if carry == true { 1 } else { 0 };
                    self.registers[4] = (sum >> 8) as u8;
                    self.registers[5] = sum as u8;
                }
                6 => {
                    let a: u8 = self.fetch();
                    let b: u8 = self.fetch();

                    self.sp = concatenate(b, a);
                }
                7 => {
                    self.flag &= 0xFE;
                    let byte: u16 = self.sp;
