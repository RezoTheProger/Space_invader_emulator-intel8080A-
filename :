    fn get_hl(&mut self) -> u16 {
        concatenate(self.registers[4], self.registers[5])
    }
    fn check_carry(&mut self, sum: u16) -> u8 {
        let carry = sum >= 256;
        if carry {
            self.flag |= 1;
        } else {
            self.flag &= 0xFE;
        }
        return (sum % 256) as u8;
    }
    fn check_borrow(&mut self, difference: u16, sub: u16) -> u8 {
        let (result, borrow) = difference.overflowing_sub(sub);
        if borrow {
            self.flag |= 1;
        } else {
            self.flag &= 0xFE;
        }
        return result as u8;
    }
    fn check_zero(&mut self, sum: &u8) {
        if *sum == 0 {
            self.flag |= 64
        } else {
            self.flag &= 0xBF;
        }
    }
    fn check_sign(&mut self, sum: &u8) {
        if *sum & 0x80 == 0x80 {
            self.flag |= 128;
        } else {
            self.flag &= 0x7F;
        }
    }
    fn check_parity(&mut self, sum: &u8) {
        let mut k: u8 = 0;
        for i in 0..8 {
            if (sum & 1 << i) == (1 << i) {
                k += 1;
            }
        }
        if k % 2 == 0 {
            self.flag |= 4;
        } else {
            self.flag &= 0xFB;
        }
    }
    fn aux_carry(&mut self, op_type: u8, a: u16, b: u16, carry: Option<u16>) {
        match op_type {
            0 => {
                if (a & 0x0F) + (b & 0x0F) + carry.unwrap_or(0) > 0x0F {
                    self.flag |= 16;
                } else {
                    self.flag &= 0xEF;
                }
            }
            1 => {
                if (a & 0x0F) >= ((b & 0x0F) + carry.unwrap_or(0)) {
                    self.flag |= 16;
                } else {
                    self.flag &= 0xEF;
                }
            }
            _ => {}
        }
    }
    fn pop(&mut self) -> u16 {
        let value: u16 = (self.memory[self.sp as usize] as u16)
            | (self.memory[self.sp.wrapping_add(1) as usize] as u16) << 8;
        self.sp = self.sp.wrapping_add(2);
        value
    }
    fn push(&mut self, value: u16) {
        self.sp = self.sp.wrapping_sub(2);
        self.memory[self.sp.wrapping_add(1) as usize] = (value >> 8) as u8;
        self.memory[self.sp as usize] = (value) as u8;
    }
    fn jump(&mut self) {
        self.pc = (self.memory[self.pc as usize] as u16)
            | (self.memory[self.pc.wrapping_add(1) as usize] as u16) << 8;
    }
    fn call(&mut self) {
        self.push(self.pc.wrapping_add(2) as u16);
        self.jump();
    }
    fn rst(&mut self, variant: u8) {
        self.push(self.pc as u16);
        self.pc = (variant as u16) * 8;
    }
    fn matcher<F>(&mut self, variant: u8, f: F)
    where
        F: FnOnce(&mut Self),
    {
        match variant {
            0 => {
                let zero: bool = (self.flag & 0x40) == 0x40;
                if !zero {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }

            1 => {
                //RZ
                let zero: bool = (self.flag & 0x40) == 0x40;
                if zero {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            2 => {
                let carry: bool = (self.flag & 0x01) == 0x01;
                if !carry {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            3 => {
                let carry: bool = (self.flag & 0x01) == 0x01;
                if carry {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            4 => {
                let pair: bool = (self.flag & 0x04) == 0x04;
                if !pair {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            5 => {
                let pair: bool = (self.flag & 0x04) == 0x04;
                if pair {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            6 => {
                let is_negative: bool = (self.flag & 0x80) == 0x80;
                if !is_negative {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            7 => {
                let is_negative: bool = (self.flag & 0x80) == 0x80;
                if is_negative {
                    f(self);
                } else {
                    self.pc = self.pc.wrapping_add(2);
                }
            }
            _ => {
                println!("somehow an issue in control");
            }
        }
    }
}

fn mask(input: u8) -> [u8; 3] {
    // 0th index: family code
    // 1th index: variant
    // 2nd: instruction
    [input >> 6, (input >> 3) & 7, input & 7]
}
pub fn concatenate(hi: u8, low: u8) -> u16 {
    let output: u16 = (hi as u16) << 8 | (low as u16);
    output
}
fn separate(byte: u16) -> (u8, u8) {
    ((byte >> 8) as u8, byte as u8)
}
