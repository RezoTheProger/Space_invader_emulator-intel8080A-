                }
            }

            7 => match register {
                0 => {
                    self.flag &= 0xFE;
                    self.registers[7] = self.registers[7].rotate_left(1);
                    self.flag |= 0x01 & self.registers[7];
                }
                1 => {
                    self.flag &= 0xFE;
                    self.registers[7] = self.registers[7].rotate_right(1);
