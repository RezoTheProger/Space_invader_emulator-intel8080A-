    fn ADD(&mut self, add: u16, carry_in: Option<u16>) {
        self.flag = 0x02;
        let sum: u16 = self.registers[7] as u16;
        self.aux_carry(0, sum, add, carry_in);
        let result: u8 = self.check_carry(sum + add + carry_in.unwrap_or(0));
        self.check_zero(&result);
        self.check_sign(&result);
        self.check_parity(&result);
        self.registers[7] = result;
    }
    fn SUB(&mut self, sub: u16, carry_in: Option<u16>) {
        self.flag = 0x02;
        let difference: u16 = self.registers[7] as u16;
        self.aux_carry(1, difference, sub, carry_in);
        let result: u8 = self.check_borrow(difference, sub + carry_in.unwrap_or(0));

        self.check_zero(&result);
        self.check_sign(&result);
        self.check_parity(&result);
        self.registers[7] = result;
    }
    fn ANA(&mut self, ana: u8) {
        self.flag &= 0x02;
        let a = self.registers[7];
        let result: u8 = self.registers[7] & ana;
        if (ana | a) & 0x08 != 0 {
            self.flag |= 0x10;
        }

        self.check_zero(&result);
        self.check_sign(&result);
        self.check_parity(&result);
        self.registers[7] = result;
    }
    fn XOR(&mut self, xor: u8) {
        self.flag = 0x02;
        let result: u8 = self.registers[7] ^ xor;

        self.check_zero(&result);
        self.check_sign(&result);
        self.check_parity(&result);
        self.registers[7] = result;
