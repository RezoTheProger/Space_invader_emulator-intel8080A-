                    self.flag &= 0xFE;
                    self.flag |= (self.registers[7] & 0x80).rotate_left(1);
                    self.registers[7] = (self.registers[7].rotate_left(1)) & 0xFE;
                    self.registers[7] |= carry;
                }
                3 => {
                    let carry = self.flag & 0x01;
                    self.flag &= 0xFE;
                    self.flag |= 0x01 & self.registers[7];
                    self.registers[7] = (self.registers[7].rotate_right(1)) & 0x7F;
                    self.registers[7] |= (carry).rotate_right(1);
                }
                4 => {
                    let mut accumulator: u8 = self.registers[7];
                    if (accumulator & 0x0F) > 9 || ((self.flag & 0x10) == 0x10) {
                        if accumulator >= 0xFA {
