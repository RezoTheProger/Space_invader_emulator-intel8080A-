pub struct CPU {
    pub memory: [u8; 0x10000],
    pub registers: [u8; 8],
    pub ports: [u8; 256],
    pub sp: u16,
    pub pc: u16,
    pub flag: u8,
    pub halted: bool,
    pub INTE: bool,
}
impl CPU {
    pub fn new() -> Self {
        CPU {
            memory: [0; 0x10000],
            registers: [0, 0, 0, 0, 0, 0, 0, 0],
            ports: [0; 256],
            sp: 0xFFFF,
            pc: 0x100,
            flag: 0x02,
            halted: false,
        }
    }
    pub fn load_rom(&mut self, rom_data: &[u8]) {
        for (i, &byte) in rom_data.iter().enumerate() {
            self.memory[0x0100 + i] = byte;
        }
    }
    pub fn fetch(&mut self) -> u8 {
        let byte = self.memory[self.pc as usize];
        self.pc = self.pc.wrapping_add(1);
        byte
    }
    pub fn decode(&mut self, opcode: u8) {
        let separated: [u8; 3] = mask(opcode);
        match separated[0] {
            0 => {
                self.optional(separated[1], separated[2]);
            }
            1 => {
                self.mov(separated[1], separated[2]);
            }
            2 => {
                self.ari(separated[1], separated[2]);
            }
            3 => {
                self.ctrl(separated[1], separated[2]);
            }
            _ => {
                println!("somehow an error occured");
                return;
            }
        }
    }
    fn optional(&mut self, register: u8, instruction: u8) {
        match instruction {
            0 => {}
            1 => match register {
                //DAD( done) and LXI(done)
                0 => {
                    let a: u8 = self.fetch();
                    let b: u8 = self.fetch();

                    self.registers[1] = a;
                    self.registers[0] = b;
                }
                1 => {
                    self.flag &= 0xFE;
                    let byte: u16 = ((self.registers[0] as u16) << 8) | self.registers[1] as u16;
                    let hl_byte: u16 = concatenate(self.registers[4], self.registers[5]);
                    let (sum, carry): (u16, bool) = byte.overflowing_add(hl_byte);
                    self.flag |= if carry == true { 1 } else { 0 };
                    self.registers[4] = (sum >> 8) as u8;
                    self.registers[5] = sum as u8;
                }
                2 => {
                    let a: u8 = self.fetch();
                    let b: u8 = self.fetch();

                    self.registers[3] = a;
                    self.registers[2] = b;
                }
                3 => {
                    self.flag &= 0xFE;
                    let byte: u16 = ((self.registers[2] as u16) << 8) | self.registers[3] as u16;
                    let hl_byte: u16 = concatenate(self.registers[4], self.registers[5]);
